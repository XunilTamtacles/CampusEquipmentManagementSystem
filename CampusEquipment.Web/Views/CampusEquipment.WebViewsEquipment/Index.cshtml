@model List<Equipment>
@{
    ViewData["Title"] = "Equipment";
}

<h1>Equipment</h1>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Asset Code</th>
            <th>Name</th>
            <th>Category</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Status</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AssetCode</td>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>@item.Brand</td>
                <td>@item.Model</td>
                <td>@item.Status</td>
                <td>@item.Department?.Name</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.EquipmentId">Details</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.EquipmentId">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Retire" asp-route-id="@item.EquipmentId">Retire</a>
                </td>
            </tr>
        }
    </tbody>
</table>